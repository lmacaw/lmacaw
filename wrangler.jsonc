{
  "name": "lmacaw",
  "main": "cloudflare/entry.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lmacaw",
      "database_id": "d7bc541f-b3ce-4ca7-9a5a-09e3644c9446",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "lmacaw-media" }],
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "lmacaw-items" }],
  "routes": [
    { "pattern": "lmacaw.meme", "custom_domain": true },
    { "pattern": "admin.lmacaw.meme", "custom_domain": true }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "AUTH_MODE": "public",
    "ADMIN_HOST": "admin.lmacaw.meme",
    "ORIGIN": "https://lmacaw.meme,https://admin.lmacaw.meme",
    "R2_BUCKET": "lmacaw-media",
    "ACCESS_TEAM_DOMAIN": "phucnht.cloudflareaccess.com",
    "ACCESS_AUD": "49b7c55e6fe2d4ba793ccf79d932654738f163641e7f8825a87884223cd16724",
    "MAIL_FROM": "Lmacaw <hello@lmacaw.meme>"
  }
}
