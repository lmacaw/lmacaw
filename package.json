{
  "name": "lmacaw",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev --test-scheduled --port 4173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply lmacaw --local",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.8.4",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-cloudflare": "7.2.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.164.0"
  },
  "dependencies": {
    "aws4fetch": "1.0.20"
  }
}
