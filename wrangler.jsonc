{
  "name": "lmacaw",
  "account_id": "5a8c36401f47fc6f64a5edcdfc2546a3",
  "main": "cloudflare/entry.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lmacaw",
      "database_id": "c2648f9d-4e58-412e-8e16-1269c37c7122",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "lmacaw-media" }],
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "lmacaw-items" }],
  "routes": [
    { "pattern": "lmacaw.meme", "custom_domain": true },
    { "pattern": "admin.lmacaw.meme", "custom_domain": true }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "AUTH_MODE": "public",
    "ADMIN_HOST": "admin.lmacaw.meme",
    "ORIGIN": "https://lmacaw.meme,https://admin.lmacaw.meme",
    "R2_BUCKET": "lmacaw-media",
    "ACCESS_TEAM_DOMAIN": "lmacaw.cloudflareaccess.com",
    "ACCESS_AUD": "2e55598c5cf931b08ed1cabfe17f178e14c530d23ac7a9dfaab25307ac1b2b45",
    "MAIL_FROM": "Lmacaw <hello@lmacaw.meme>"
  }
}
