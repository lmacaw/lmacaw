DATABASE_URL=postgresql://lmacaw:lmacaw@localhost:5432/lmacaw
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
LMACAW_PORT=3000
ORIGIN=http://localhost:3000
# Other addresses browsers may use, comma-separated (for example a LAN IP next to a public domain).
ALLOWED_ORIGINS=
MEDIA_STORAGE=filesystem
MEDIA_ROOT=./data/media
# Set the same random token on the server and optional AI worker.
AI_WORKER_TOKEN=
# For S3-compatible storage, set MEDIA_STORAGE=s3 and configure:
# S3_ENDPOINT=https://storage.example.com
# S3_REGION=auto
# S3_BUCKET=lmacaw
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
